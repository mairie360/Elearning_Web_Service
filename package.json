{
  "name": "frontend-nextjs-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "contracts:generate": "node scripts/contracts.mjs --generate",
    "contracts:check": "node scripts/contracts.mjs --check",
    "contracts:sync": "node scripts/contracts.mjs --sync",
    "test:contracts": "node --test tests/*.test.cjs",
    "test": "mkdir -p coverage && node --enable-source-maps --test --experimental-test-coverage --test-coverage-branches=60 --test-coverage-functions=60 --test-coverage-lines=60 --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.cjs",
    "performance:report": "node scripts/frontend-performance.mjs"
  },
  "dependencies": {
    "@mairie360/bff-elearning-openapi": "0.0.0-dev.c4c3f73724b9b34c1c9ebe5830130308a2242fa2",
    "@mairie360/lib-components": "0.8.0",
    "axios": "1.20.0",
    "lucide-react": "^1.0.0",
    "next": "16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@mairie360/front-kit": "file:vendor/mairie360-front-kit-0.1.0.tgz"
  },
  "overrides": {
    "next": {
      ".": "$next",
      "postcss": "^8.5.23",
      "sharp": "^0.35.5"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "playwright-core": "1.64.0"
  }
}
